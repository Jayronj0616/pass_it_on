{
  "$schema": "https://raw.githubusercontent.com/HeisenbergI8/provenly/main/harness.schema.json",
  "commands": {
    "verify": "npm run typecheck",
    "verifyFast": "npm run lint"
  },
  "source": {
    "include": [
      "src/**",
      "app/**",
      "lib/**",
      "test/**",
      "tests/**"
    ],
    "exclude": [
      "**/*.md",
      "**/__snapshots__/**"
    ]
  }
}
